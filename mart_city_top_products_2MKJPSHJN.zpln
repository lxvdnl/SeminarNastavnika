    {
      "text": "%spark.pyspark\nfrom pyspark.sql.window import Window\n\nwindow = Window.partitionBy(\"city\").orderBy(F.desc(\"revenue_sum\"))\n\nmart_top = mart.withColumn(\"rank\", F.row_number().over(window)) \\\n               .filter(F.col(\"rank\") <= 2) \\\n               .drop(\"rank\")\n\nmart_top.show()",
